{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm -r:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "mcp__Context7__*",
      "mcp__context7__*",
      "mcp__claude_ai_Context7__*",
      "mcp__plugin_context7_context7__*"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf /*)",
      "Bash(gh repo delete:*)",
      "Bash(wrangler *deploy*)",
      "Bash(pnpm *wrangler *deploy*)",
      "Bash(npx wrangler *deploy*)",
      "Bash(wrangler *delete*)",
      "Bash(pnpm *wrangler *delete*)",
      "Bash(npx wrangler *delete*)",
      "Bash(wrangler *secret*)",
      "Bash(pnpm *wrangler *secret*)",
      "Bash(npx wrangler *secret*)",
      "Bash(wrangler *rollback*)",
      "Bash(pnpm *wrangler *rollback*)",
      "Bash(npx wrangler *rollback*)",
      "Bash(wrangler *versions upload*)",
      "Bash(pnpm *wrangler *versions upload*)",
      "Bash(npx wrangler *versions upload*)",
      "Bash(wrangler *--remote*)",
      "Bash(pnpm *wrangler *--remote*)",
      "Bash(npx wrangler *--remote*)",
      "Bash(pnpm *deploy:cloudflare*)",
      "Bash(npm *deploy:cloudflare*)",
      "Bash(pnpm --filter * deploy*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.*)",
      "Read(!.env.example)",
      "Read(!.dev.vars.example)"
    ]
  }
}
