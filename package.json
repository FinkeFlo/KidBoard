{
  "name": "kidboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Icon-first family calendar and meal plan for a wall-mounted kiosk tablet.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/ensure-web-dist.mjs && pnpm --parallel --filter @kidboard/web --filter @kidboard/worker dev",
    "build": "pnpm --filter @kidboard/web build && pnpm --filter @kidboard/worker build",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @kidboard/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"process.exit(require('fs').existsSync('.git')?0:1)\" && lefthook install || echo \"skipping lefthook install\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
