# KidBoard worker - local secrets for `wrangler dev` (dotenv format).
# Copy to `apps/worker/.dev.vars` (git-ignored). NEVER commit real values.
# In production set these with `wrangler secret put <NAME>` / the dashboard.
# See docs/CONFIG.md for details.

# Secret iCal addresses, one per configured calendar: CAL_<ID>_URL, where <ID> is the
# calendar id from config.example.json in upper case.
# Google Calendar: Settings > your calendar > "Secret address in iCal format".
CAL_KINDER_URL="https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics"
CAL_ESSEN_URL="https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics"
# Optional per-child calendars (id "mia" -> CAL_MIA_URL):
# CAL_MIA_URL="https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics"

# Optional: if set, API requests must send this token. Leave empty/unset to disable.
# KIDBOARD_ACCESS_TOKEN=REPLACE_ME

# Optional: comma-separated list of allowed CORS origins (default: same origin only).
KIDBOARD_ALLOWED_ORIGINS="http://localhost:5173"

# Optional: how long fetched feeds count as fresh, in seconds (default 3600).
KIDBOARD_CACHE_TTL=3600

# Non-secret settings as one JSON document (shape: config.example.json, options:
# docs/CONFIG.md). Paste it as a single line, or set it as a plain variable instead.
# KIDBOARD_CONFIG='{"locale":"de","timeZone":"Europe/Berlin","calendars":[{"id":"kinder","kind":"events"}]}'
