{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Source cache (ADR-0006). No id on purpose: Wrangler provisions the namespace on the
  // first deploy (also for dashboard/Git deploys); `wrangler dev` uses a local one.
  "kv_namespaces": [{ "binding": "KIDBOARD_CACHE" }]
}
